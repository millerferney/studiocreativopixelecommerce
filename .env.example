# ───────────── Base de datos ─────────────
# El motor se deduce del esquema de la URL: postgresql://… (Supabase) o mysql://… (MySQL 8).
# MySQL:  DATABASE_URL="mysql://USUARIO:CLAVE@HOST:3306/studio_creativo_pixel?ssl=true"  (idéntica en DIRECT_URL)
# ───────────── PostgreSQL / Supabase ─────────────
# Runtime (Vercel): cadena del POOLER en modo transacción (puerto 6543) — Supabase > Connect > Transaction pooler
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Migraciones/scripts (psql, prisma): conexión directa (puerto 5432) o Session pooler
DIRECT_URL="postgresql://postgres:CLAVE@db.PROYECTO.supabase.co:5432/postgres"

# ───────────── Sesión (JWT en cookie httpOnly) ─────────────
# Genera uno con:  openssl rand -base64 48
AUTH_SECRET="I/5OEvcjgjrtFQGyrXwhKG6tNO009wTza0rrBmYCuOXMU7onVybrEJw89hp87OBz"
SESSION_HOURS=8

# ───────────── Primer administrador (npm run db:admin) ─────────────
ADMIN_EMAIL="admin@studiocreativopixel.com"
ADMIN_PASSWORD="Admin12345"
ADMIN_NOMBRE="Administrador Pixel"

# ───────────── Supabase Storage (archivos de diseño del cliente) — opcional ─────────────
SUPABASE_URL="https://PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="solo-servidor-nunca-NEXT_PUBLIC"
SUPABASE_BUCKET="disenos"

# ───────────── Facturación electrónica ─────────────
# SIMULADO = genera CUFE + XML UBL 2.1 sin firma (sin validez DIAN). Ver README para proveedor real.
INVOICE_PROVIDER="SIMULADO"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────────── Correos transaccionales ─────────────
# CONSOLE (por defecto, no envía) | RESEND | SMTP
MAIL_PROVIDER="RESEND"
MAIL_FROM="Studio Creativo Pixel <no-reply@StudioCreativoPixel.com>"
MAIL_REPLY_TO=""
# Copia al equipo cuando entra un pedido pagado (opcional)
MAIL_ADMIN_TO=""
# — Resend —
RESEND_API_KEY=""
# — SMTP (Brevo, Gmail con clave de aplicación, Mailgun, SES, etc.) —
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
