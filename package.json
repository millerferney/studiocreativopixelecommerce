{
  "name": "pixel-store",
  "version": "1.0.0",
  "private": true,
  "description": "Studio Creativo Pixel — e-commerce (Next.js 16 + Prisma + PostgreSQL/Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:schema": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f db/01_schema.sql",
    "db:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f db/02_seed.sql",
    "db:admin": "tsx --env-file=.env scripts/crear-admin.ts",
    "db:pull": "prisma db pull",
    "test": "tsx --test src/server/__tests__/*.test.ts",
    "db:schema-prisma": "python3 scripts/gen-prisma-schema.py > prisma/schema.prisma && prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.67.0",
    "next": "^16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^7.10.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
